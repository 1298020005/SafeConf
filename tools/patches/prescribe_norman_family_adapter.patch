+def _load_norman_family(data_name: str, seed: int) -> PertData:
+    """Load a frozen Norman panel without silently dropping non-GO perturbations.
+
+    PRESCRIBE's encoder consumes scGPT perturbation embeddings and its ``Get_Graph``
+    helper does not construct a GO graph.  The bundled GEARS loader nevertheless
+    filters conditions against GO membership before building cell graphs.  Extend
+    the in-memory lookup for every gene in the already-frozen split so this
+    unrelated filter cannot change the task contract.
+    """
+    split_file = Path(f"data/{data_name}/set2conditions_{seed}.pkl")
+    frozen_genes = []
+    if split_file.exists():
+        with split_file.open("rb") as handle:
+            frozen = pickle.load(handle)
+        for condition in frozen["train"] + frozen["val"] + frozen["test"]:
+            for gene in condition.split("+"):
+                if gene != "ctrl" and gene not in frozen_genes:
+                    frozen_genes.append(gene)
+    gene_set_path = split_file.with_name(f"frozen_pert_gene_set_{seed}.pkl")
+    with gene_set_path.open("wb") as handle:
+        pickle.dump(frozen_genes, handle)
+    pert_data = PertData("data/", gene_set_path=str(gene_set_path), default_pert_graph=False)
+    for gene in frozen_genes:
+        pert_data.gene2go.setdefault(gene, set())
+    if data_name == "norman":
+        pert_data.load(data_name=data_name)
+    else:
+        pert_data.load(data_path=f"data/{data_name}")
+    return pert_data
+
